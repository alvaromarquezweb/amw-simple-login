msgid "Page background"
msgstr "Fondo de página"

msgid "Form background"
msgstr "Fondo del formulario"

msgid "Notices and messages background"
msgstr "Fondo de avisos y mensajes"

msgid "Fields background"
msgstr "Fondo de los campos"

msgid "Border color"
msgstr "Color de bordes"

msgid "Primary text"
msgstr "Texto principal"

msgid "Secondary text / labels"
msgstr "Texto secundario / etiquetas"

msgid "Button (background)"
msgstr "Botón (fondo)"

msgid "Button (text)"
msgstr "Botón (texto)"

msgid "Dark"
msgstr "Oscuro"

msgid "Light"
msgstr "Claro"

msgid "Slate"
msgstr "Pizarra"

msgid "Settings"
msgstr "Ajustes"

msgid "AMW Login"
msgstr "AMW Login"

msgid "You are not allowed to do this."
msgstr "No tienes permiso para hacer esto."

msgid "Settings imported successfully."
msgstr "Ajustes importados correctamente."

msgid "Import failed: the pasted text is not valid JSON."
msgstr "La importación ha fallado: el texto pegado no es un JSON válido."

msgid "Select logo"
msgstr "Seleccionar logo"

msgid "Change logo"
msgstr "Cambiar logo"

msgid "Remove"
msgstr "Eliminar"

msgid "Use this logo"
msgstr "Usar este logo"

msgid "AMW Simple Login"
msgstr "AMW Simple Login"

msgid "Open the login screen"
msgstr "Ver la pantalla de acceso"

msgid "Logo"
msgstr "Logo"

msgid "Login logo"
msgstr "Logo del login"

msgid "If you do not select a logo, the Customizer logo (Site Identity) is used. If there is none either, the plugin fallback logo is shown."
msgstr "Si no seleccionas un logo, se usará el del Personalizador (Identidad del sitio). Si tampoco hay ninguno, se mostrará el logo de reserva del plugin."

msgid "Background image"
msgstr "Imagen de fondo"

msgid "Image"
msgstr "Imagen"

msgid "Change image"
msgstr "Cambiar imagen"

msgid "Select image"
msgstr "Seleccionar imagen"

msgid "With no image, the login uses the \"No image\" style below. Use a light image: the login screen is not cached and loads fully on every visit."
msgstr "Sin imagen, el login usa el estilo «Sin imagen» de abajo. Usa una imagen ligera: la pantalla de acceso no se cachea y se carga entera en cada acceso."

msgid "Form position"
msgstr "Disposición del formulario"

msgid "Left (image on the right)"
msgstr "Izquierda (imagen a la derecha)"

msgid "Center (full-screen image)"
msgstr "Centro (imagen a pantalla completa)"

msgid "Right (image on the left)"
msgstr "Derecha (imagen a la izquierda)"

msgid "Only applies when an image is set. On mobile the form is always centered over the image."
msgstr "Solo tiene efecto cuando hay imagen. En móvil el formulario siempre se muestra centrado sobre la imagen."

msgid "Image blur"
msgstr "Desenfoque de la imagen"

msgid "From 0 (no blur) to 20. Combined with the darkening it gives a frosted-glass effect and improves legibility over busy photos."
msgstr "De 0 (sin desenfoque) a 20. Combinado con el oscurecido da un efecto cristal esmerilado y mejora la legibilidad sobre fotos con mucho detalle."

msgid "Darkening color"
msgstr "Color del oscurecido"

msgid "Darkening intensity"
msgstr "Intensidad del oscurecido"

msgid "Color layer over the image. Raise the intensity to darken the photo; the color can be your brand tone instead of black."
msgstr "Capa de color sobre la imagen. Sube la intensidad para oscurecer más la foto; el color puede ser tu tono de marca en vez de negro."

msgid "Select background image"
msgstr "Seleccionar imagen de fondo"

msgid "Use this image"
msgstr "Usar esta imagen"

msgid "Background when no image is set"
msgstr "Fondo cuando no hay imagen"

msgid "Style"
msgstr "Estilo"

msgid "Default (uses the palette page color)"
msgstr "Por defecto (usa el color de página de la paleta)"

msgid "Solid color"
msgstr "Color sólido"

msgid "Gradient"
msgstr "Degradado"

msgid "Only applies when there is no background image. The form stays centered."
msgstr "Solo tiene efecto cuando no hay imagen de fondo. El formulario se mantiene centrado."

msgid "Start"
msgstr "Inicio"

msgid "End"
msgstr "Fin"

msgid "Angle"
msgstr "Ángulo"

msgid "Color palette"
msgstr "Paleta de colores"

msgid "Presets:"
msgstr "Presets:"

msgid "Fills the colors below. Remember to save."
msgstr "Rellena los colores de abajo. Recuerda guardar."

msgid "Interface options"
msgstr "Opciones de interfaz"

msgid "Corner radius"
msgstr "Redondeo de esquinas"

msgid "From 0 (square corners) to 24. Fields and the button use a slightly smaller radius so the box stays balanced."
msgstr "De 0 (esquinas rectas) a 24. Los campos y el botón usan un redondeo algo menor para que la caja no quede desproporcionada."

msgid "Hide \"Go to [site]\""
msgstr "Ocultar «Volver a [sitio]»"

msgid "Hide \"Lost your password?\""
msgstr "Ocultar «¿Olvidaste tu contraseña?»"

msgid "Only hides the link on the login screen. Password recovery still works via direct URL."
msgstr "Solo oculta el enlace en la pantalla de acceso. La recuperación de contraseña sigue funcionando por URL directa."

msgid "Heading text"
msgstr "Texto de encabezado"

msgid "Text above the form"
msgstr "Texto sobre el formulario"

msgid "e.g. Welcome to Client Name"
msgstr "p. ej. Bienvenido a Nombre del Cliente"

msgid "Optional. Shown between the logo and the form. Leave empty to hide it."
msgstr "Opcional. Se muestra entre el logo y el formulario. Déjalo vacío para ocultarlo."

msgid "Extra CSS"
msgstr "CSS extra"

msgid "Custom CSS for the login"
msgstr "CSS personalizado para el login"

msgid "Injected only on the login screen, after the plugin styles. For per-site tweaks without editing files."
msgstr "Se inyecta solo en la pantalla de acceso, después de los estilos del plugin. Para retoques por sitio sin tocar archivos."

msgid "Legal links in the login footer"
msgstr "Enlaces legales al pie del login"

msgid "Show legal links"
msgstr "Mostrar enlaces legales"

msgid "Legal notice"
msgstr "Aviso Legal"

msgid "Privacy policy"
msgstr "Política de Privacidad"

msgid "Cookie policy"
msgstr "Política de Cookies"

msgid "Link text · Page URL"
msgstr "Texto del enlace · URL de la página"

msgid "Export / Import settings"
msgstr "Exportar / Importar ajustes"

msgid "Copy the JSON to replicate this configuration on another site, or paste a saved configuration to import it."
msgstr "Copia el JSON para replicar esta configuración en otro sitio, o pega una configuración guardada para importarla."

msgid "Export"
msgstr "Exportar"

msgid "Copy"
msgstr "Copiar"

msgid "Download .json"
msgstr "Descargar .json"

msgid "Import"
msgstr "Importar"

msgid "Import settings"
msgstr "Importar ajustes"

msgid "Overwrites the current configuration on this site."
msgstr "Sobrescribe la configuración actual de este sitio."

msgid "The credentials you entered are not correct."
msgstr "Las credenciales introducidas no son correctas."

